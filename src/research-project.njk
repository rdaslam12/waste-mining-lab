---
layout: layouts/section.njk
pagination:
  data: catalog.publishedResearchProjects
  size: 1
  alias: project
permalink: "/research/{{ project.slug }}/index.html"
eleventyComputed:
  title: "{{ project.title }} — Research"
  description: "{{ project.summary }}"
navKey: research
---
<article class="project-detail">
  <header class="editorial-intro project-detail-header"><div class="index-line"><div class="project-badges">{% if project.area %}<span class="small-label">{{ project.area.title }}</span>{% endif %}<span class="project-status-tag project-status-tag--{{ project.status }}">{{ project.status | projectStatus }}</span></div></div><h1>{{ project.title }}</h1>{% if project.summary %}<p class="lead">{{ project.summary }}</p>{% endif %}{% if project.start_date or project.end_date or project.collaborations or project.funding_notes %}<div class="project-metadata-strip">{% if project.start_date or project.end_date %}<div class="meta-item"><span class="meta-label">Timeline</span><span class="meta-value">{% if project.start_date and project.end_date %}{{ project.start_date | monthYear }} – {{ project.end_date | monthYear }}{% elif project.start_date %}Active since {{ project.start_date | monthYear }}{% else %}Completed in {{ project.end_date | monthYear }}{% endif %}</span></div>{% endif %}{% if project.collaborations %}<div class="meta-item"><span class="meta-label">Collaborators</span><span class="meta-value">{{ project.collaborations }}</span></div>{% endif %}{% if project.funding_notes %}<div class="meta-item"><span class="meta-label">Sponsors &amp; Grants</span><span class="meta-value">{{ project.funding_notes }}</span></div>{% endif %}</div>{% endif %}</header>
  {% if project.image %}<figure class="project-detail-hero"><img src="{{ project.image }}" alt="{{ project.image_alt or project.title }}" decoding="async">{% if project.image_alt %}<figcaption>{{ project.image_alt }}</figcaption>{% endif %}</figure>{% endif %}
  <div class="project-detail-body">
    {% if project.description_html %}<section class="project-overview-section" aria-labelledby="overview-title"><h2 id="overview-title">Overview &amp; Objectives</h2><div class="reading-copy">{{ project.description_html | safe }}</div></section>{% endif %}
    {% if project.methodology_html %}<section class="project-methodology-section" aria-labelledby="methodology-title"><div class="section-heading"><h2 id="methodology-title">Scientific Methodology</h2><span class="small-label">Experimental Design &amp; Protocols</span></div><div class="reading-copy">{{ project.methodology_html | safe }}</div></section>{% endif %}
    {% if project.related_grants.length %}<section class="project-grants-section" aria-labelledby="project-grants-title"><div class="section-heading"><h2 id="project-grants-title">Grant Support</h2><a href="/grants/" class="editorial-link">View all grants</a></div><div class="grants-grid">{% for grant in project.related_grants %}{% include "partials/grant-card.njk" %}{% endfor %}</div></section>{% endif %}
    {% if project.related_publications.length %}<section class="project-publications section-space" aria-labelledby="project-publications-title"><div class="section-heading"><h2 id="project-publications-title">Related Publications</h2><a href="/publications/" class="editorial-link">View publication index</a></div><div class="text-links">{% for publication in project.related_publications %}{% if publication.published %}<a href="/publications/?q={{ publication.title | urlencode }}#publication-{{ publication.legacy_id or publication.slug }}">{{ publication.title }}</a>{% endif %}{% endfor %}</div></section>{% endif %}
    {% if project.related_members.length %}<section class="project-team-section" aria-labelledby="project-team-title"><div class="section-heading"><h2 id="project-team-title">Project Investigators &amp; Contributors</h2><a href="/team/" class="editorial-link">Meet the team</a></div><div class="member-grid">{% for member in project.related_members %}<article class="member-profile">{% if member.image %}<img src="{{ member.image }}" alt="{{ member.image_alt or member.name }}" loading="lazy">{% endif %}<div><h3>{{ member.name }}</h3><p class="member-role">{{ member.role }}</p>{% if member.affiliation %}<p>{{ member.affiliation }}</p>{% endif %}{% if member.biography %}<p>{{ member.biography }}</p>{% endif %}<div class="text-links">{% if member.email %}<a href="mailto:{{ member.email }}">Email {{ member.name }}</a>{% endif %}{% if member.profile_url %}<a href="{{ member.profile_url }}">View profile</a>{% endif %}</div></div></article>{% endfor %}</div></section>{% endif %}
    {% if project.related_activities.length %}<section class="section-space" aria-labelledby="project-activities-title"><div class="section-heading"><h2 id="project-activities-title">Related Activities</h2><a href="/activity/" class="editorial-link">View activity journal</a></div><div class="text-links">{% for activity in project.related_activities %}<a href="/activity/#activity-{{ activity.legacy_id or activity.slug }}">{{ activity.title }}</a>{% endfor %}</div></section>{% endif %}
  </div>
  <div class="project-back-strip"><a href="/research/" class="editorial-button">Return to Research Portfolio</a></div>
</article>
