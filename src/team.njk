---
layout: layouts/section.njk
title: Team
description: Meet the researchers and collaborators of Waste Mining Lab.
navKey: team
permalink: /team/index.html
---
{% set publishedTeam = catalog.team | filterPublished %}
{% set directors = publishedTeam | filterCategory('director') %}
{% set director = directors[0] %}
{% set assistants = publishedTeam | filterCategory('assistant') %}
{% set alumni = publishedTeam | filterCategory('alumni') %}
<header class="visually-hidden"><h1>Team &amp; People</h1></header>
<figure class="team-hero-photo"><picture><source srcset="/assets/images/team-photo-1628.webp 1628w, /assets/images/team-photo-960.webp 960w" type="image/webp"><img src="/assets/images/team-photo.png" alt="Waste Mining Lab research team gathered outdoors during a site visit." width="1628" height="916" decoding="async"></picture><figcaption class="team-hero-caption">Waste Mining Lab research team gathered during a field campaign.</figcaption></figure>
<section class="director-spotlight-section" aria-labelledby="director-heading">
  <div class="section-heading"><h2 id="director-heading">Laboratory Leadership</h2><span class="small-label">Principal Investigator</span></div>
  {% if director %}<div class="director-spotlight-card" id="member-{{ director.slug }}">
    <figure class="director-frame"><img src="{{ director.image or '/assets/images/asef-redwan-1080.webp' }}" width="1080" height="1080" alt="{{ director.image_alt or 'Dr. Asef M. Redwan speaking to students in a classroom.' }}" class="director-img" decoding="async"><figcaption class="director-caption">{{ director.name }} · Laboratory Director</figcaption></figure>
    <div class="director-content"><span class="director-title-badge">Principal Investigator &amp; Lab Director</span><h3 class="director-name">{{ director.name }}</h3><p class="director-credentials">{{ director.role }}<br>{{ director.affiliation }}</p><div class="director-bio">{% for paragraph in director.biography.split('\n\n') %}<p>{{ paragraph }}</p>{% endfor %}</div>{% if director.research_interests %}<div class="director-focus"><span class="small-label">Research Focus</span><p>{{ director.research_interests }}</p></div>{% endif %}<div class="director-actions">{% if director.profile_url %}<a href="{{ director.profile_url }}" class="editorial-button" target="_blank" rel="noopener noreferrer">University Profile</a>{% endif %}{% if director.email %}<a href="mailto:{{ director.email }}" class="editorial-link">Email Dr. Redwan</a>{% endif %}{% if director.scholar_url %}<a href="{{ director.scholar_url }}" class="editorial-link" target="_blank" rel="noopener noreferrer">Google Scholar</a>{% endif %}</div></div>
  </div>{% else %}<p class="muted">Laboratory leadership details will appear once published.</p>{% endif %}
</section>
{% if assistants.length %}<section class="section-space team-ra-section" aria-labelledby="ra-heading"><div class="section-heading"><h2 id="ra-heading">Research Assistants</h2><span class="small-label">{{ assistants.length }} Appointment{% if assistants.length != 1 %}s{% endif %}</span></div><div class="ra-grid">{% for member in assistants %}<article class="ra-card" id="member-{{ member.slug }}"><div class="ra-avatar">{% if member.image %}<img src="{{ member.image }}" alt="{{ member.image_alt or member.name }}" loading="lazy">{% else %}<div class="ra-initials-placeholder" aria-hidden="true">{{ member.name | initials }}</div>{% endif %}</div><div class="ra-info"><h3 class="ra-name">{{ member.name }}</h3><p>{{ member.role }}</p>{% if member.biography %}<details><summary>Profile details</summary><p>{{ member.biography }}</p></details>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}
{% set otherCategories = ['scientist', 'researcher', 'student', 'staff', 'collaborator'] %}
{% for category in otherCategories %}{% set members = publishedTeam | filterCategory(category) %}{% if members.length %}<section class="section-space team-contributors-section" aria-labelledby="team-{{ category }}"><div class="section-heading"><h2 id="team-{{ category }}">{% if category == 'scientist' or category == 'researcher' %}Research Scientists &amp; Researchers{% elif category == 'student' %}Graduate &amp; Undergraduate Researchers{% elif category == 'staff' %}Research Officers &amp; Laboratory Staff{% else %}Collaborators &amp; Co-Researchers{% endif %}</h2></div><div class="contributors-slider-wrap"><div class="contributors-slider" tabindex="0" role="region" aria-label="Laboratory contributors">{% for member in members %}<article class="contributor-card" id="member-{{ member.slug }}"><div class="contributor-media">{% if member.image %}<img src="{{ member.image }}" alt="{{ member.image_alt or member.name }}" loading="lazy">{% else %}<div class="ra-initials-placeholder" aria-hidden="true">{{ member.name | initials }}</div>{% endif %}</div><div class="contributor-body"><h3 class="contributor-name">{{ member.name }}</h3><p class="contributor-role">{{ member.role }}</p>{% if member.academic_background %}<p class="contributor-bg">{{ member.academic_background }}</p>{% endif %}{% if member.biography %}<details><summary>Profile details</summary><p>{{ member.biography }}</p></details>{% endif %}</div></article>{% endfor %}</div></div></section>{% endif %}{% endfor %}
{% if alumni.length %}<section class="team-alumni-toggle-container section-space"><div class="alumni-toggle-wrap"><button type="button" class="editorial-button alumni-toggle-btn" id="alumni-toggle-btn" aria-expanded="false" aria-controls="team-alumni-section">Show Alumni</button></div><div id="team-alumni-section" class="team-alumni-section" hidden aria-labelledby="alumni-heading"><div class="section-heading"><h2 id="alumni-heading">Alumni &amp; Former Members</h2></div><div class="alumni-grid">{% for member in alumni %}<article class="alumni-card" id="member-{{ member.slug }}"><div class="alumni-media">{% if member.image %}<img src="{{ member.image }}" alt="{{ member.image_alt or member.name }}" loading="lazy">{% else %}<div class="ra-initials-placeholder" aria-hidden="true">{{ member.name | initials }}</div>{% endif %}</div><div class="alumni-info"><h3>{{ member.name }}</h3><p class="alumni-role">{{ member.role }}</p>{% if member.alumni_current_position %}<p class="alumni-dest">Current: {{ member.alumni_current_position }}</p>{% endif %}</div></article>{% endfor %}</div></div></section>{% endif %}
